{"userHTML":"<!DOCTYPE html>\n<html>\n    <body>\n        <p id=\"lockStatus\">Lock: Disabled</p>\n        <p id=\"openStatus\">‎‎NaN</p>\n        <button onclick=\"lock()\">On/Off</button>\n\n        <button onclick=\"trigger()\">Open</button>\n        <button onclick=\"untrigger()\">Close</button>\n    </body>\n</html>","userCSS":"","userJS":"const lockWord = document.getElementById(\"lockStatus\");\nconst lockedWord = document.getElementById(\"openStatus\");\nvar locked = -1;\nvar lockWordAdd = \"Disabled\";\nconst lockedWords = \"Alert! Alarm triggered\";\nvar buzz = false;\n\nfunction lock() {\n    locked *= -1;\n\n    if (locked == 1) {\n        lockWordAdd = \"Enabled\";\n    } else {\n        lockWordAdd = \"Disabled\";\n    }\n\n    lockWord.innerHTML = \"Lock: \" + lockWordAdd;\n};\n\nfunction trigger() {\n    if (locked == 1) {\n        lockedWord.innerHTML = lockedWords;\n        turnOn(Buzzer);\n        buzz = true;\n    };\n};\n\nfunction untrigger() {\n    lockedWord.innerHTML = \"‎‎NaN‎\";\n    turnOff(Buzzer);\n    buzz = false;\n};\n\nfunction check() {\n    if (digitalIn(LightBlockSensor) == 1) {\n        return false;\n    } else {\n        return true;\n    }\n};","userJSLoop":"if (check() && !buzzer) {\n    trigger();\n} else if (!check() && buzzer) {\n    untrigger();\n}","boardName":"ESP32","userBoard":{"D2":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO","DIGITAL_IN"],"index":0,"name":"","value":0,"config":"DISABLED"},"D4":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO","DIGITAL_IN","DS18X20_IN"],"index":1,"name":"","value":0,"config":"DISABLED"},"D5":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO"],"index":2,"name":"","value":0,"config":"DISABLED"},"D12":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO"],"index":3,"name":"","value":0,"config":"DISABLED"},"D13":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO","DIGITAL_IN"],"index":4,"name":"","value":0,"config":"DISABLED"},"D14":{"options":["DISABLED","DIGITAL_OUT","PWM","SERVO"]